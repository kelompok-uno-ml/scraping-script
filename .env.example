# Copy this file to .env and fill in the values. Never commit .env.
# Salt used for SHA-256 creator username hashing. Generate a long random value:
# python -c "import secrets; print(secrets.token_hex(32))"
SCRAPE_SALT=replace-with-a-long-random-string

# Instagram: prefer manual login with `python -m src.scrape_instagram --login`
# so credentials do not need to be stored here.
IG_USERNAME=
IG_PASSWORD=
